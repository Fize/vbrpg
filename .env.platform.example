NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://vbrpg:vbrpgpassword@localhost:5433/vbrpg_platform
AUTH_TOKEN_SECRET=replace-with-at-least-16-random-characters
DEEPSEEK_API_KEY=
AI_API_KEY=
