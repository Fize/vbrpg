NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://vbrpg:vbrpgpassword@localhost:5433/vbrpg_platform
# 32-byte base64 key that seals provider credentials. Required in production.
PLATFORM_CREDENTIAL_KEY=
PLATFORM_CREDENTIAL_KEY_VERSION=1
# Exact origins allowed for cookie-authenticated writes. Required (https) in production.
TRUSTED_WEB_ORIGINS=http://localhost:5173
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=1000
