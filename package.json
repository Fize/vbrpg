{
  "name": "vbrpg-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter @vbrpg/platform build",
    "typecheck": "pnpm --filter @vbrpg/platform typecheck",
    "lint": "pnpm --filter @vbrpg/platform lint",
    "format": "pnpm --filter @vbrpg/platform format",
    "format:check": "pnpm --filter @vbrpg/platform format:check",
    "test": "pnpm --filter @vbrpg/platform test",
    "test:db": "pnpm --filter @vbrpg/platform test:db",
    "test:e2e": "pnpm --filter @vbrpg/platform test:e2e",
    "dev": "pnpm --filter @vbrpg/platform dev",
    "dev:web": "pnpm --filter @vbrpg/platform dev:web",
    "dev:worker": "pnpm --filter @vbrpg/platform dev:worker",
    "migrate": "pnpm --filter @vbrpg/platform migrate",
    "migrate:down": "pnpm --filter @vbrpg/platform migrate:down",
    "bootstrap-admin": "pnpm --filter @vbrpg/platform bootstrap-admin",
    "check:provider-endpoint": "pnpm --filter @vbrpg/platform check:provider-endpoint",
    "check:model-call": "pnpm --filter @vbrpg/platform check:model-call",
    "rotate-credential-key": "pnpm --filter @vbrpg/platform rotate-credential-key"
  }
}
