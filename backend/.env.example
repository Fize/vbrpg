# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/vbrpg.db

# AI API Key for LLM Integration (OpenAI-compatible, e.g. DeepSeek)
AI_API_KEY=sk-your-deepseek-or-openai-compatible-key-here
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
AI_TIMEOUT=60
AI_MAX_RETRIES=3

# Application Security
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-urlsafe-32

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=DEBUG

# SQLAlchemy
SQLALCHEMY_ECHO=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
