{
  "name": "@vbrpg/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/main.ts --role=api",
    "dev:worker": "tsx watch src/server/main.ts --role=worker",
    "dev:web": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.server.json && vite build",
    "build:server": "rm -rf dist/server dist/shared && tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start:api": "node dist/server/main.js --role=api",
    "start:worker": "node dist/server/main.js --role=worker",
    "typecheck": "tsc -p tsconfig.shared.json --noEmit && tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:down": "tsx scripts/migrate.ts --down",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "check:provider-endpoint": "tsx scripts/provider-connection-check.ts",
    "test:db": "tsx scripts/db-integration.ts",
    "test:e2e": "playwright test",
    "check:model-call": "tsx scripts/model-call-check.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.7",
    "fastify": "^5.6.1",
    "kysely": "^0.28.2",
    "pg": "^8.16.3",
    "vue": "3.5.43",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.13"
  }
}
